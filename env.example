PORT=8000
DB_PATH=sqlite:///./data/cv_builder.db

## Enabled scrapers
ENABLED_SCRAPERS=wwr,remotive,jobicy,get_on_board

JOB_TECHS=WordPress,Django,Laravel,PHP,Python

# RSS
WWR_RSS=https://weworkremotely.com/remote-jobs.rss,https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss,https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss

REMOTEOK_URL=https://remoteok.com/api # Require subscription for applying to jobs

REMOTIVE_URL=https://remotive.com/api/remote-jobs
REMOTIVE_CATEGORY=software-development

JOBICY_URL=https://jobicy.com/api/v2/remote-jobs
JOBICY_LOCATIONS=anywhere,latam
JOBICY_INDUSTRIES=engineering,web-app-design

GET_ON_BOARD_URL=https://www.getonbrd.com/api/v0

# ==========================================
# EVALUATE JOB SETTINGS
# ==========================================
EVALUATE_ENGINE=gemini
EVALUATE_MODEL=gemini-3.5-flash
EVALUATE_JOB_TEMPERATURE=0.1
EVALUATE_JOB_TOKENS=3000
EVALUATE_PAUSE_BETWEEN_REQUEST=5.0

# ==========================================
# WRITE CV SETTINGS
# ==========================================
WRITE_CV_ENGINE=gemini
WRITE_CV_MODEL=gemini-3.5-flash
WRITE_CV_TEMPERATURE=0.05
WRITE_CV_TOKENS=8000
WRITE_CV_PAUSE_BETWEEN_REQUEST=5.0
CV_PREFIX=[YOUR-NAME]

# Anthropic (Claude)
ANTHROPIC_API_KEY=[API-KEY]
CLAUDE_LIGHT_MODEL=claude-3-5-haiku-20241022"
CLAUDE_PRO_MODEL=claude-3-5-sonnet-20241022

# Gemini
GEMINI_API_KEY=[API-KEY]
GEMINI_LIGHT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-3.5-flash

# Ollama
OLLAMA_PORT=11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_LIGHT_MODEL=qwen2.5:3b
OLLAMA_PRO_MODEL=qwen2.5:7b

# OpenAI
OPENAI_API_KEY=[API-KEY]
OPENAI_LIGHT_MODEL=gpt-4o-mini
OPENAI_PRO_MODEL=gpt-4o
