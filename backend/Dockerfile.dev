# Usamos Python (versión estable recomendada)
FROM python:3.12-slim

# Variables de entorno para evitar problemas con logs y caché de bytecode
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Declaramos el argumento que vendrá desde docker-compose (por defecto ollama si no se especifica)
ARG EVALUATE_ENGINE=ollama
ARG WRITE_CV_ENGINE=gemini

# Directorio de trabajo dentro del contenedor
WORKDIR /app

# Instalamos dependencias del sistema necesarias
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libffi-dev \
    libjpeg-dev \
    libimagequant-dev \
    libwebp-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiamos el requirements base (FastAPI, SQLModel, Pydantic, etc.)
COPY requirements.txt .

# Copiamos todos los requirements específicos de los proveedores que tengas
COPY requirements-*.txt ./

# Actualizamos pip e instalamos primero las dependencias base
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# Instalamos de forma condicional el requirements del motor seleccionado 
RUN if [ -f "requirements-${EVALUATE_ENGINE}.txt" ]; then \
        echo "Instalando dependencias para el motor: ${EVALUATE_ENGINE}" && \
        pip install --no-cache-dir -r requirements-${EVALUATE_ENGINE}.txt; \
    else \
        echo "No se encontró un archivo de requerimientos específico para '${EVALUATE_ENGINE}', omitiendo..."; \
    fi

# Instalamos de forma condicional el requirements del motor seleccionado 
RUN if [ -f "requirements-${WRITE_CV_ENGINE}.txt" ]; then \
        echo "Instalando dependencias para el motor: ${WRITE_CV_ENGINE}" && \
        pip install --no-cache-dir -r requirements-${WRITE_CV_ENGINE}.txt; \
    else \
        echo "No se encontró un archivo de requerimientos específico para '${WRITE_CV_ENGINE}', omitiendo..."; \
    fi

# Copiamos el resto del código del backend
COPY . .

# Exponemos el puerto del contenedor
EXPOSE 8080

# Comando para arrancar FastAPI con hot-reload 
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]