# Usamos Python (versión estable recomendada)
FROM python:3.12-slim

# Variables de entorno para evitar problemas con logs y caché de bytecode
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Directorio de trabajo dentro del contenedor
WORKDIR /app

# Instalamos dependencias del sistema necesarias
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libffi-dev \
    libjpeg-dev \
    libimagequant-dev \
    libwebp-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiamos primero el archivo de dependencias
COPY requirements.txt .

# Actualizamos pip e instalamos las dependencias de Python
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Instalamos Playwright y sus navegadores
RUN playwright install --with-deps chromium

# Copiamos el resto del código del backend
COPY . .

# Exponemos el puerto del contenedor
EXPOSE 8080

# Comando para arrancar FastAPI con hot-reload 
# (Nota: cambiamos app.main:app por main:app al quitar la carpeta app)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]