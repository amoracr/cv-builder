# Usamos Python (versión estable recomendada para producción y desarrollo moderno)
FROM python:3.12-slim

# Variables de entorno para evitar problemas con logs y caché de bytecode
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Directorio de trabajo
WORKDIR /app

# Instalamos dependencias del sistema necesarias para Weasyprint (renderizado de PDF) 
# y dependencias base para compilación
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libffi-dev \
    libjpeg-dev \
    libimagequant-dev \
    libwebp-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiamos primero el archivo de dependencias para aprovechar la caché de Docker
COPY requirements.txt .

# Actualizamos pip e instalamos las dependencias de Python
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Instalamos Playwright y sus navegadores/dependencias del sistema operativo nativas
RUN playwright install --with-deps chromium

# Copiamos el resto de la aplicación
COPY . .

# Exponemos el puerto del contenedor (8080 según tu docker-compose)
EXPOSE 8080

# Comando para arrancar FastAPI con hot-reload (equivalente a lo que hacías con air en Go)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]